<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.shopeefy</groupId>
    <artifactId>dev-idp</artifactId>
    <version>1.0.0</version>
    <name>dev-idp</name>
    <description>Local OpenID Connect provider (Spring Authorization Server) for running and demoing the OAuth2 login without real Google credentials</description>

    <properties>
        <java.version>25</java.version>
        <tomcat.version>11.0.26</tomcat.version>   <!-- fixes CVE-2026-65182, -65905, -68525 in Boot's 11.0.24 [OWASP A03:2025] -->
        <jackson-bom.version>3.1.7</jackson-bom.version>       <!-- fixes CVE-2026-68497 in Boot's 3.1.5 [OWASP A03:2025] -->
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>  <!-- same CVE in Boot's 2.21.5 -->
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-authorization-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
